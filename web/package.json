  "scripts": {
    "build": "vite build && npm run build:types && npm run build:vendor && node scripts/assert-no-lit.mjs && node scripts/assert-subpath-entries.mjs && node scripts/assert-ssr-import.mjs",
    "build:vendor": "vite build --config vite.vendor.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:browser && npm run build && npm run test:bundle && npm run test:react",
    "test:watch": "wtr --config web-test-runner.config.mjs --watch",
    "stubs": "node scripts/generate-stubs.mjs",
    "prepublishOnly": "npm run build",
    "test:browser": "wtr --config web-test-runner.config.mjs",
    "test:react": "node scripts/smoke-react.mjs",
    "demo:voice": "node scripts/serve-voice-demo.mjs",
    "test:e2e": "cypress run",
    "test:e2e:voice": "cypress run --spec e2e/voice-agent.cy.ts",
    "isolation:server": "node scripts/serve-isolation.mjs",
    "isolation:importmap": "node scripts/generate-isolation-importmap.mjs",
    "isolation:report": "node scripts/generate-isolation-report.mjs",
    "test:isolation": "cypress run --config-file cypress.isolation.config.ts",
    "isolation:report:html": "node scripts/generate-isolation-html-report.mjs",
    "test:bundle": "node scripts/assert-bundle-side-effects.mjs"
  },
